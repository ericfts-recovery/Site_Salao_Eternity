# URL pública do site (sem barra no final) — usada em canonical, sitemap e Open Graph
NEXT_PUBLIC_SITE_URL=https://www.salaoeternity.com.br

# Google Analytics 4 (opcional). Só carrega depois que a visitante aceita os cookies.
NEXT_PUBLIC_GA_ID=

# Resend (opcional). Sem estas variáveis o formulário continua funcionando:
# o pedido é encaminhado para o WhatsApp do salão.
RESEND_API_KEY=
BOOKING_EMAIL_TO=
BOOKING_EMAIL_FROM="Site Eternity <agendamento@salaoeternity.com.br>"
